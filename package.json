{
  "name": "warframe-kb-template",
  "version": "0.1.0",
  "private": true,
  "description": "Шаблон личной базы Warframe, которой управляет ИИ-агент: правила, структура данных и скрипты импорта",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
